# EvidenceRoom configuration
# Copy to .env and adjust as needed. All values are optional for the MVP.

# SQLite database URL (SQLAlchemy async). Default: sqlite+aiosqlite:///./evidence.db
DATABASE_URL=sqlite+aiosqlite:///./evidence.db

# Semantic retrieval (optional). When unset, the deterministic fallback embedder
# is used so hybrid retrieval still runs. Set EMBEDDING_API_KEY to activate real
# API-based embeddings (e.g. OpenAI-compatible).
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small

# LLM for the evidence gate and reasoning (optional). When unset, the
# deterministic fallback gate/conclusion is used so /analyze runs without a key.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
